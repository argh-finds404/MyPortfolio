PORT=5000
# Comma-separated list of allowed front-end origins
CLIENT_ORIGIN=http://localhost:3000
# MongoDB Atlas or local, e.g. mongodb://127.0.0.1:27017/portfolio
MONGODB_URI=
# Secret for the /api/messages inbox endpoints (send it as the x-admin-key header)
ADMIN_KEY=change-me
# Optional: email yourself each enquiry (Gmail: smtp.gmail.com, port 465, app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
